# Copy to .env.local and fill in. Never commit real keys.

# Qloo hackathon key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key)
# Without it the app runs on clearly-labelled SIMULATED data.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Gemini API key (https://aistudio.google.com/apikey)
# Without it a deterministic "autopilot" planner drives the same Qloo tools.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
