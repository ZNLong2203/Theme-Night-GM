# Copy to .env.local and fill in. Never commit real keys.

# Qloo hackathon key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key)
# Without it the app runs on clearly-labelled SIMULATED data.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Gemini API key (https://aistudio.google.com/apikey)
# Without it a deterministic "autopilot" planner drives the same Qloo tools.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=low   # low | medium | high

# Optional store for shareable /plan links, run replays, featured plans and a shared Qloo cache.
# Without one, everything works but lives only in this server's memory. Use either:
# REDIS_URL=rediss://...             # any Redis (Vercel Marketplace "Redis" sets this)
# KV_REST_API_URL=https://...        # or Upstash over REST (also UPSTASH_REDIS_REST_URL)
# KV_REST_API_TOKEN=

# Optional demo limits
# RUNS_PER_10_MIN=6
# REVISIONS_PER_10_MIN=12
# MAX_CONCURRENT_RUNS=4
# QLOO_TRENDING_END=2025-09-28
